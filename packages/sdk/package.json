{
  "name": "hai-agents",
  "version": "0.7.0",
  "description": "TypeScript SDK for H Company's Agent Platform — class-based client with sync/async support, fully typed.",
  "type": "module",
  "license": "MIT",
  "author": "H Company <contact@hcompany.ai>",
  "homepage": "https://hcompany.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hcompai/hai-agents-ts.git"
  },
  "bugs": {
    "url": "https://github.com/hcompai/hai-agents-ts/issues"
  },
  "keywords": [
    "agent",
    "agents",
    "computer-use",
    "browser-use",
    "llm",
    "sdk",
    "h-company"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
