{
  "name": "hai-agents",
  "version": "1.2.7",
  "description": "TypeScript SDK for H Company's Agents API: autonomous agents powered by Holo.",
  "keywords": [
    "agent",
    "agents",
    "computer-use",
    "browser-use",
    "llm",
    "sdk",
    "h-company"
  ],
  "homepage": "https://hub.hcompany.ai/agents-api/introduction",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hcompai/hai-agents-ts.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/hcompai/hai-agents-ts/issues"
  },
  "author": "H Company <contact@hcompany.ai>",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./local": {
      "types": "./dist/local/index.d.ts",
      "import": "./dist/local/index.js",
      "require": "./dist/local/index.cjs"
    },
    "./playwright": {
      "types": "./dist/playwright/index.d.ts",
      "import": "./dist/playwright/index.js",
      "require": "./dist/playwright/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts src/local/index.ts src/playwright/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "zod": "^4.0.0",
    "playwright-core": ">=1.45.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4",
    "zod": "^4.6.7"
  }
}
