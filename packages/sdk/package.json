{
  "name": "hai-agents",
  "version": "1.5.4",
  "description": "TypeScript SDK for H Company's Agents API: autonomous agents powered by Holo.",
  "keywords": [
    "agent",
    "agents",
    "computer-use",
    "browser-use",
    "llm",
    "sdk",
    "h-company"
  ],
  "homepage": "https://hub.hcompany.ai/agents-api/introduction",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hcompai/hai-agents-ts.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/hcompai/hai-agents-ts/issues"
  },
  "author": "H Company <contact@hcompany.ai>",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./local": {
      "types": "./dist/local.d.ts",
      "import": "./dist/local.js",
      "require": "./dist/local.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.4"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --external ../local/index.js && tsup --entry.local src/local/index.ts --format esm,cjs --dts --external ../client/index.js && node scripts/link-local-entry.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "undici": "^6.29.1"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  },
  "typesVersions": {
    "*": {
      "local": [
        "./dist/local.d.ts"
      ]
    }
  }
}
